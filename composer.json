{
	"name": "fisharebest/localization",
	"description": "A lightweight localization database and translation tools, with data from the CLDR, IANA, ISO, etc.",
	"type": "library",
	"keywords": [
		"localization", "locale", "language", "script", "translate", "translation", "i18n", "l10n", "cldr", "gettext"
	],
	"homepage": "https://github.com/fisharebest/localization",
	"license": "GPL-3.0-or-later",
	"authors": [{
			"name": "Greg Roach",
			"email": "greg@subaqua.co.uk",
			"role": "Developer"
	}],
	"support": {
			"issues": "https://github.com/fisharebest/localization/issues"
	},
	"require": {
		"php": "8.2 - 8.4"
	},
	"require-dev": {
		"ext-simplexml": "*",
		"phpunit/phpunit": "11.4.4",
		"phpstan/phpstan": "2.0.3",
		"phpstan/extension-installer": "1.4.3",
		"phpstan/phpstan-deprecation-rules": "2.0.1",
		"phpstan/phpstan-strict-rules": "2.0.0",
		"phpstan/phpstan-phpunit": "2.0.1",
		"squizlabs/php_codesniffer": "3.11.1"
	},
	"autoload": {
		"psr-4": {
			"Fisharebest\\Localization\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Fisharebest\\LocalizationTest\\": "test/"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
    "scripts": {
        "ci" : [
            "@composer validate",
            "@composer phpcs",
            "@composer phpunit",
            "@composer phpstan"
        ],
        "phpcs": [
            "vendor/bin/phpcs --colors --standard=PSR12 src test"
        ],
        "phpstan": [
            "vendor/bin/phpstan analyze --verbose --level=6 src test"
        ],
        "phpunit": [
            "vendor/bin/phpunit"
        ]
    }
}
